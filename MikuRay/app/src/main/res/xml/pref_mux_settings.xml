<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.miku.ray.widget.UwuPreferenceCategory
        android:key="pref_category_mux_settings"
        android:title="@string/title_mux_settings"
        app:sectionIcon="@drawable/rmx_development_git_merge_line">

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_toggle_line"
            android:key="pref_mux_enabled"
            android:summary="@string/summary_pref_mux_enabled"
            android:title="@string/title_pref_mux_enabled"
            app:layout="@layout/uwu_top_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch" />

        <EditTextPreference
            android:dialogMessage="@string/title_pref_mux_concurency_tip"
            android:icon="@drawable/rmx_hashtag"
            android:inputType="number"
            android:key="pref_mux_concurrency"
            android:summary="8"
            android:title="@string/title_pref_mux_concurency"
            app:dialogIcon="@drawable/rmx_hashtag"
            app:layout="@layout/uwu_mid" />

        <EditTextPreference
            android:dialogMessage="@string/title_pref_mux_concurency_tip"
            android:icon="@drawable/rmx_hashtag"
            android:inputType="number"
            android:key="pref_mux_xudp_concurrency"
            android:summary="8"
            android:title="@string/title_pref_mux_xudp_concurency"
            app:dialogIcon="@drawable/rmx_hashtag"
            app:layout="@layout/uwu_mid" />

        <ListPreference
            android:defaultValue="reject"
            android:entries="@array/mux_xudp_quic_entries"
            android:entryValues="@array/mux_xudp_quic_value"
            android:icon="@drawable/rmx_eth_line"
            android:key="pref_mux_xudp_quic"
            android:summary="%s"
            android:title="@string/title_pref_mux_xudp_quic"
            app:dialogIcon="@drawable/rmx_eth_line"
            app:layout="@layout/uwu_bot" />

    </com.miku.ray.widget.UwuPreferenceCategory>

</PreferenceScreen>
