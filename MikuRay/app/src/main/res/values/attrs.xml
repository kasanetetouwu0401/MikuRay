<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr format="color" name="colorBg" />
    <attr format="color" name="colorCard" />

    <attr name="siArrowPosition">
        <enum name="left" value="0" />
        <enum name="right" value="1" />
    </attr>
    <attr name="siBorderType">
        <enum name="stroke" value="0" />
        <enum name="fill" value="1" />
    </attr>
    <attr name="siStrokeCap">
        <enum name="butt" value="0" />
        <enum name="round" value="1" />
        <enum name="square" value="2" />
    </attr>
    <attr name="siStrokeJoin">
        <enum name="bevel" value="0" />
        <enum name="miter" value="1" />
        <enum name="round" value="2" />
    </attr>
    <declare-styleable name="ShaderImageView">
        <attr format="boolean" name="siSquare" />
        <attr format="color" name="siBorderColor" />
        <attr format="dimension" name="siBorderWidth" />
        <attr format="float" name="siBorderAlpha" />
        <attr format="integer|reference" name="siForeground" />
        <attr format="dimension" name="siRadius" />
        <attr name="siArrowPosition" />
        <attr format="dimension" name="siTriangleHeight" />
        <attr format="integer|reference" name="siShape" />
        <attr name="siBorderType" />
        <attr name="siStrokeCap" />
        <attr name="siStrokeJoin" />
        <attr format="dimension" name="siStrokeMiter" />
    </declare-styleable>

    <declare-styleable name="ExpandableView">
        <attr format="integer" name="el_duration" />
        <attr format="boolean" name="el_expanded" />
        <attr format="float" name="el_parallax" />
        <attr format="enum" name="el_orientation">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="ExpandableLayout">
        <attr format="reference" name="el_headerViewId" />
        <attr format="reference" name="el_arrowViewId" />
        <attr format="reference" name="el_contentViewId" />
    </declare-styleable>

    <declare-styleable name="DynamicShapeImageView">
        <attr format="color|reference" name="shapeBackgroundColor" />
        <attr format="enum" name="shapeTarget">
            <enum name="icon" value="0" />
            <enum name="arrow" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="UwuHeaderIconView">
        <attr format="reference" name="sectionIcon" />
    </declare-styleable>

    <declare-styleable name="ParticlesView">
        <attr
            format="dimension"
            name="particleRadiusMin" />
        <attr
            format="dimension"
            name="particleRadiusMax" />
        <attr
            format="dimension"
            name="lineThickness" />
        <attr
            format="dimension"
            name="lineLength" />
        <attr
            format="integer"
            name="density" />
        <attr
            format="color"
            name="particleColor" />
        <attr
            format="color"
            name="lineColor" />
        <attr
            format="integer"
            name="frameDelayMillis" />
        <attr
            format="float"
            name="speedFactor" />
    </declare-styleable>

    <declare-styleable name="SearchPreference">
        <attr format="string" name="textHint" />
        <attr format="string" name="textNoResults" />
        <attr format="string" name="textClearHistory" />
        <attr format="string" name="textClearInput" />
        <attr format="string" name="textMore" />
    </declare-styleable>

    <declare-styleable name="BlurView">
        <attr format="color" name="blurOverlayColor" />
    </declare-styleable>

</resources>
