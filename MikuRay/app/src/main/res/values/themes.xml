<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppThemeBase" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="android:colorBackground">?colorBg</item>
        <item name="android:windowBackground">?colorBg</item>
        <item name="colorBg">?colorSurfaceVariant</item>
        <item name="colorCard">?colorSurfaceContainerLow</item>
        <item name="strokeDrawable">@android:color/white</item>
        <item name="strokeDrawableBg">?colorSurfaceContainerLow</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="bottomSheetDialogTheme">@style/AppThemeBottomSheetDialog</item>
        <item name="sideSheetDialogTheme">@style/AppThemeSideSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/AppThemeAlertDialog</item>
        <item name="alertDialogTheme">@style/AppThemeAlertDialog</item>
        <item name="android:scrollbarSize">0.0dip</item>
        <item name="android:listDivider">@null</item>
        <item name="android:colorEdgeEffect">@null</item>
        <item name="elevation">0.0dip</item>
        <item name="preferenceTheme">@style/AppThemePreference</item>
        <item name="android:homeAsUpIndicator">@drawable/rmx_arrows_arrow_left_double_line</item>
        <item name="actionOverflowButtonStyle">@style/AppTheme.OverflowButton</item>
        
    </style>

    <style name="AppTheme.OverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/rmx_more_2_line</item>
        <item name="srcCompat">@drawable/rmx_more_2_line</item>
    </style>

<style name="Theme.App.Splash" parent="@style/AppThemeBase">
        <item name="android:windowSplashScreenBackground">?colorBg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="AppThemePreference" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/AppThemePreferenceItem</item>
        <item name="checkBoxPreferenceStyle">@style/AppThemePreferenceItem</item>
        <item name="switchPreferenceCompatStyle">@style/AppThemePreferenceItem</item>
        <item name="dialogPreferenceStyle">@style/AppThemePreferenceItem</item>
        <item name="seekBarPreferenceStyle">@style/AppThemePreferenceItem</item>
        <item name="editTextPreferenceStyle">@style/AppThemeEditTextPreference</item>
        <item name="preferenceCategoryStyle">@style/AppThemePreferenceCategory</item>
    </style>

    <style name="AppThemePreferenceItem" parent="@style/Preference.Material">
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="allowDividerAbove">false</item>
    </style>
    <style name="AppThemeEditTextPreference" parent="@style/Preference.DialogPreference.EditTextPreference.Material">
        <item name="dialogLayout">@layout/uwu_dialog_edittext</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="AppThemePreferenceCategory" parent="@style/Preference.Category.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="AppThemeBottomSheetDialog" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@style/Animation.Material3.BottomSheetDialog</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="bottomSheetStyle">@style/AppThemeBottomSheetStyle</item>
    </style>

    <style name="AppThemeBottomSheetStyle" parent="@style/Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorBg</item>
        <item name="shapeAppearance">@style/AppThemeBottomSheetShape</item>
    </style>

    <style name="AppThemeBottomSheetShape" parent="@style/ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">35dp</item>
        <item name="cornerSizeTopRight">35dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="AppThemeSideSheetDialog" parent="@style/ThemeOverlay.Material3.SideSheetDialog">
        <item name="android:windowAnimationStyle">@style/Animation.Material3.SideSheetDialog</item>
        <item name="sideSheetModalStyle">@style/AppThemeSideSheetStyle</item>
    </style>

    <style name="AppThemeSideSheetStyle" parent="@style/Widget.Material3.SideSheet.Modal">
        <item name="android:layout_width">286dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="backgroundTint">?attr/colorBg</item>
        <item name="shapeAppearance">@style/AppThemeSideSheetShape</item>
    </style>

    <style name="AppThemeSideSheetShape" parent="@style/ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="AppThemeAlertDialog" parent="@style/ThemeOverlay.Material3Expressive.MaterialAlertDialog.Centered">
        <item name="shapeAppearance">@style/AppThemeAlertDialogShape</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainer</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogFilledButtonPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogFilledButtonSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/CustomDialogFilledButtonNeutral</item>
        <item name="android:windowAnimationStyle">@style/MaterialAlertDialog.Material3.Animation</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:listPreferredItemHeightSmall">60dp</item>
        <item name="android:windowMinWidthMajor">91%</item>
        <item name="android:windowMinWidthMinor">91%</item>
        <item name="materialAlertDialogTitleIconStyle">@style/AppThemeAlertDialogTitleIcon</item>
    </style>
    
    <style name="AppThemeAlertDialogTitleIcon" parent="@style/MaterialAlertDialog.Material3.Title.Icon.CenterStacked">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="CustomDialogFilledButtonPrimary" parent="Widget.Material3Expressive.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <style name="CustomDialogFilledButtonSecondary" parent="Widget.Material3Expressive.Button">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <style name="CustomDialogFilledButtonNeutral" parent="Widget.Material3Expressive.Button">
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <style name="AppThemeAlertDialogShape" parent="@style/ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="@style/AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    
    <style name="BrandedSwitch" parent="AppThemeBase">
        <item name="colorPrimary">@color/color_fab_active</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TabLayoutTextStyle" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppThemeCrashLogger" parent="@style/AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    
    <style name="ThemeOverlay.App.TrueBlack.DialogFix">
        <item name="alertDialogTheme">@style/ThemeOverlay.App.TrueBlack.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.TrueBlack.AlertDialog</item>
    </style>
    
    <style name="ShapeAppearance.App.CardView.Top" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <style name="ShapeAppearance.App.CardView.Middle" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <style name="ShapeAppearance.App.CardView.Bottom" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <style name="ShapeAppearance.App.CardView.Single" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <style name="AppThemeToolbarCircleNavigationButton" parent="">
        <item name="toolbarNavigationButtonCircleColor">?attr/colorCard</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.Material3.Toolbar.Button.Navigation.Circle</item>
    </style>

</resources>