// Liquid Glass refraction shader for MikuRay's LiquidGlassBlurView.
//
// This is a from-scratch reconstruction: the ported blur3 Java classes call
// AndroidUtilities.readRes(R.raw.liquid_glass_shader) to load this file at
// runtime, but the shader source itself wasn't among the files that were
// shared, only the Java side that feeds it uniforms. The uniform names,
// types and value ranges below are taken directly from LiquidGlassEffect.java
// so the contract matches; the actual refraction math is an original
// implementation of the "glass edge bends what's behind it" look and will
// likely want some visual tuning once you see it running on a device.
//
// img                              - the blurred backdrop content (bound automatically
//                                    by RenderEffect.createRuntimeShaderEffect(shader, "img"))
// resolution                       - full render node size in px (width, height)
// center                           - center of the rounded rect, in the same px space as fragCoord
// size                             - HALF-extents (width/2, height/2) of the rounded rect
// radius                           - per-corner radius in px, order: (rightBottom, rightTop, leftBottom, leftTop)
// thickness                        - width in px of the refracting glass edge band
// refract_intensity                - 0..1-ish strength of the edge bending
// refract_index                    - ~1.0-2.0, how sharply the edge bends (1.0 = no bend)
// foreground_color_premultiplied   - premultiplied tint blended over the result

uniform shader img;
uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_intensity;
uniform float refract_index;
uniform float4 foreground_color_premultiplied;

float roundedBoxSDF(float2 p, float2 halfSize, float4 r) {
    float rad;
    if (p.x > 0.0) {
        rad = (p.y > 0.0) ? r.x : r.y;
    } else {
        rad = (p.y > 0.0) ? r.z : r.w;
    }
    float2 q = abs(p) - halfSize + rad;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - rad;
}

half4 main(float2 fragCoord) {
    float2 p = fragCoord - center;
    float d = roundedBoxSDF(p, size, radius);

    if (d > 0.5) {
        return half4(0.0, 0.0, 0.0, 0.0);
    }

    float2 sampleCoord = fragCoord;

    if (thickness > 0.0 && d > -thickness) {
        float eps = 1.0;
        float2 grad = float2(
            roundedBoxSDF(p + float2(eps, 0.0), size, radius) - roundedBoxSDF(p - float2(eps, 0.0), size, radius),
            roundedBoxSDF(p + float2(0.0, eps), size, radius) - roundedBoxSDF(p - float2(0.0, eps), size, radius)
        );
        float gradLen = length(grad);
        float2 normal = gradLen > 0.0001 ? grad / gradLen : float2(0.0, 0.0);

        float edgeFactor = 1.0 - smoothstep(-thickness, 0.0, d);
        float bend = edgeFactor * refract_intensity * thickness * (refract_index - 1.0);
        sampleCoord = fragCoord - normal * bend;
    }

    half4 color = half4(img.eval(sampleCoord));

    half4 tint = half4(foreground_color_premultiplied);
    color = color * (1.0 - tint.a) + tint;

    float edgeAlpha = 1.0 - smoothstep(-0.5, 0.5, d);
    color *= edgeAlpha;

    return color;
}
