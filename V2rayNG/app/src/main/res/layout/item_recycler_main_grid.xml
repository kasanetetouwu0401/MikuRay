<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@+id/item_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4.0dip"
    android:layout_marginBottom="4.0dip"
    android:layout_marginStart="8.0dip"
    android:layout_marginEnd="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_card"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?colorCard"
        app:cardCornerRadius="16.0dip"
        app:cardElevation="0.0dip"
        app:strokeColor="?colorOutlineVariant"
        app:strokeWidth="0.0dip"
        android:layerType="none">
        <LinearLayout
            android:id="@+id/layout_indicator"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/info_container"
                android:paddingTop="10.0dip"
                android:paddingBottom="8.0dip"
                android:paddingStart="10.0dip"
                android:paddingEnd="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <!-- Baris 1: nama + status dot -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical|top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:id="@+id/tv_name"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:ellipsize="end"
                        android:maxLines="1" />
                    <View
                        android:id="@+id/v_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Baris 2: alamat, selalu 1 baris sendiri -->
                <TextView
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="11.0sp"
                    android:textColor="?colorOnSurfaceVariant"
                    android:id="@+id/tv_statistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3.0dip"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <!--
                    Baris badge: protokol, subscription, network/security.
                    Pakai FlexboxLayout supaya kalau semua badge gak muat
                    dalam satu baris (kolom sempit di grid mode), badge
                    yang gak muat otomatis pindah ke baris baru (wrap),
                    bukan numpuk/kepotong kayak LinearLayout horizontal biasa.
                -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layout_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    app:flexWrap="wrap"
                    app:alignItems="flex_start"
                    app:justifyContent="flex_start">

                    <com.google.android.material.chip.Chip
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?colorOnSecondaryContainer"
                        android:textSize="10.0sp"
                        android:id="@+id/tv_type"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="24.0dip"
                        android:layout_marginEnd="4.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:checkable="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:chipBackgroundColor="?colorSecondaryContainer"
                        app:chipMinTouchTargetSize="0.0dip"
                        app:chipStartPadding="8.0dip"
                        app:chipEndPadding="8.0dip" />

                    <!-- placeholder kosong, dipakai adapter buat kontrol visibility bareng tv_subscription -->
                    <View
                        android:id="@+id/layout_subscription"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip" />

                    <com.google.android.material.chip.Chip
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?colorOnTertiaryContainer"
                        android:textSize="10.0sp"
                        android:id="@+id/tv_subscription"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="24.0dip"
                        android:layout_marginEnd="4.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:checkable="false"
                        android:maxWidth="120.0dip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:chipBackgroundColor="?colorTertiaryContainer"
                        app:chipMinTouchTargetSize="0.0dip"
                        app:chipStartPadding="8.0dip"
                        app:chipEndPadding="8.0dip" />

                    <LinearLayout
                        android:id="@+id/layout_network_security"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="24.0dip"
                        android:layout_marginBottom="4.0dip"
                        android:background="@drawable/bg_icon_button"
                        android:paddingStart="6.0dip"
                        android:paddingEnd="6.0dip"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tv_network"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="10.0sp"
                            android:textColor="?colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6.0dip"
                            android:drawablePadding="2.0dip"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            android:maxLines="1" />
                        <TextView
                            android:id="@+id/tv_security"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textSize="10.0sp"
                            android:textColor="?colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="2.0dip"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            android:maxLines="1" />
                    </LinearLayout>
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Baris ping + traffic, di bawah badge, gak akan numpuk sama badge lagi -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textSize="11.0sp"
                        android:textColor="@color/colorPing"
                        android:id="@+id/tv_test_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />
                    <View
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        android:layout_weight="1.0" />
                    <TextView
                        android:id="@+id/tv_traffic"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textSize="10.0sp"
                        android:textColor="?colorOnSurfaceVariant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6.0dip"
                        android:visibility="gone"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Baris tombol aksi, selalu di bawah sendiri -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/layout_share"
                        android:layout_width="32.0dip"
                        android:layout_height="32.0dip"
                        android:contentDescription="@string/title_configuration_share"
                        android:background="@drawable/bg_icon_button"
                        android:focusable="true"
                        app:srcCompat="@drawable/ic_share_color"
                        app:tint="@null" />
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/layout_edit"
                        android:layout_width="32.0dip"
                        android:layout_height="32.0dip"
                        android:layout_marginStart="4.0dip"
                        android:contentDescription="@string/menu_item_edit_config"
                        android:background="@drawable/bg_icon_button"
                        android:focusable="true"
                        app:srcCompat="@drawable/ic_edit_color"
                        app:tint="@null" />
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/layout_remove"
                        android:layout_width="32.0dip"
                        android:layout_height="32.0dip"
                        android:layout_marginStart="4.0dip"
                        android:contentDescription="@string/menu_item_del_config"
                        android:background="@drawable/bg_icon_button"
                        android:focusable="true"
                        app:srcCompat="@drawable/ic_delete_empty"
                        app:tint="?colorError" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
