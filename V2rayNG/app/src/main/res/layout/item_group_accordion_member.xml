<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_member_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/iv_member_selected"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_check_circle"
        app:tint="?colorPrimary"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_member_name"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?colorOnSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="VMESS (AU) DigitalOcean" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_member_address"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                tools:text="1.2.3.4 : 443" />

            <TextView
                android:id="@+id/tv_member_ping"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/colorPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                tools:text="120ms" />
            
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_member_edit"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/menu_item_edit_config"
        android:focusable="true"
        app:srcCompat="@drawable/ic_edit_color"
        app:tint="@null" />
</LinearLayout>
