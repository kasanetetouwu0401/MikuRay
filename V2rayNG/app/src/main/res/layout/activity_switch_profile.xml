<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout ini simpel — window sudah floating dialog dari theme (Theme.AppDialog).
    Android otomatis handle: dim background, rounded window, ukuran dialog.
    Tidak perlu card/scrim manual.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Judul dialog -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="@string/action_switch_profile"
        android:textAppearance="?textAppearanceTitleMedium"
        android:textColor="?colorOnSurface" />

    <!-- TabLayout: sama persis gaya MainActivity -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_group"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="2dp"
        android:background="@android:color/transparent"
        app:tabIndicator="@drawable/uwu_tabs_rounded_indicator"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="?colorPrimary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="40dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabPaddingStart="4dp"
        app:tabPaddingEnd="4dp"
        app:tabRippleColor="@android:color/transparent" />

    <!-- ViewPager2: server list per grup, tinggi fixed -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="360dp" />

</LinearLayout>
