<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_switch_profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_switch_profile_sheet"
            android:textAppearance="?textAppearanceTitleMedium"
            android:textColor="?colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_switch_profile_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle_switch_profile_sheet"
            android:textAppearance="?textAppearanceBodySmall"
            android:textColor="?colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?colorCard"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:contentPadding="5dp"
        app:strokeWidth="0dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:clipToOutline="true"
            android:clipChildren="true">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_group_switch_profile"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:tabIndicator="@drawable/uwu_tabs_rounded_indicator"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="?colorPrimary"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="40dp"
                app:tabMinWidth="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextAppearance="?textAppearanceTitleSmall"
                app:tabSelectedTextColor="?colorSurface"
                app:tabTextAppearance="?textAppearanceTitleSmall"
                app:tabTextColor="?colorOnSurfaceVariant" />

        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_switch_profile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:minHeight="360dp" />

</LinearLayout>
