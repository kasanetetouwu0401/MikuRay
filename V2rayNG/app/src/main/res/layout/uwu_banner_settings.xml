<?xml version="1.0" encoding="utf-8"?>
<!-- Pastikan root layout (atau parent di luarnya) memberi padding/margin yang cukup -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSecondaryContainer"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="220dp">

        <!-- Teks Judul -->
        <TextView
            android:id="@+id/tv_banner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:text="@string/uwu_banner_settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/iv_banner_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Teks Deskripsi -->
        <TextView
            android:id="@+id/tv_banner_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:alpha="0.8"
            android:text="@string/uwu_banner_settings_summary"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_banner_title"
            app:layout_constraintStart_toStartOf="@+id/tv_banner_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_banner_title"
            app:layout_constraintVertical_bias="0.0" />

        <!-- Gambar Karakter (Miku) -->
        <ImageView
            android:id="@+id/iv_banner_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/uwu_banner_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4" /> <!-- Memakan 40% ruang di sebelah kanan -->

        <!-- Logo Opsional (Jika masih ingin dipakai, ditumpuk di atas banner) -->
        <ImageView
            android:id="@+id/iv_addon_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/uwu_addon_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
