<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?colorBg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="0dp"
        app:layout_scrollFlags="scroll"
        app:cardBackgroundColor="?colorCard"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_aim_color" />

            <com.bytehamster.lib.preferencesearch.SearchPreferenceActionView
                android:id="@+id/search_action_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                app:iconifiedByDefault="false"
                app:closeIcon="@drawable/ic_close"
                app:queryBackground="@android:color/transparent"
                app:submitBackground="@android:color/transparent"
                app:searchIcon="@null"
                app:queryHint="@string/searchpreference_search" />

            <!--
                Same weather / total-traffic chip as MainActivity's
                layout_weather_chip. Mutually exclusive, driven by
                PREF_SHOW_WEATHER_CHIP / PREF_SHOW_TOTAL_TRAFFIC_CHIP,
                refreshed in SettingsActivity (see refreshSearchBarChip()).
            -->
            <LinearLayout
                android:id="@+id/layout_weather_chip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_weather_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_weather_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_weather_sunny"
                    android:tint="?colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="29°C" />

                <ImageView
                    android:id="@+id/iv_total_traffic_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_traffic_total"
                    android:tint="?colorOnSurfaceVariant"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_total_traffic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="1.2 GB" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
