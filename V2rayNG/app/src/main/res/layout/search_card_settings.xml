<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Direct sibling of CollapsingToolbarLayout inside AppBarLayout (NOT a
        child of it). app:layout_scrollFlags="scroll" makes it scroll away
        together with the large title as soon as the user scrolls the
        preference list, instead of staying pinned like the toolbar.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:layout_scrollFlags="scroll"
        app:cardBackgroundColor="?colorCard"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_aim_color" />

            <com.bytehamster.lib.preferencesearch.SearchPreferenceActionView
                android:id="@+id/search_action_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                app:iconifiedByDefault="false"
                app:closeIcon="@drawable/ic_close"
                app:queryBackground="@android:color/transparent"
                app:submitBackground="@android:color/transparent"
                app:searchIcon="@null"
                app:queryHint="@string/searchpreference_search" />

            <LinearLayout
                android:id="@+id/layout_search_result_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_weather_chip"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_search_result_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="5 hasil" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
